POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://domainconsole:replace-with-a-database-password@127.0.0.1:5432/domainconsole
AUTH_URL=http://localhost:3010
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
PLATFORM_ADMIN_USER_IDS=
CREDENTIAL_ENCRYPTION_KEY=
# Configure these using your own mail service.
SMTP_HOST=
SMTP_PORT=587
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Available for users who opt in; set false to disable globally.
RENEWAL_REMINDERS_ENABLED=true
# Enable with SMTP in production on both the web and worker processes.
WELCOME_EMAILS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
DEMO_MODE=true
PROVIDER_WRITES_ENABLED=false
SENTRY_DSN=
