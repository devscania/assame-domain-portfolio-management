{
  "name": "domain-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/ensure-prisma.mjs",
    "preworker": "node scripts/ensure-prisma.mjs",
    "setup:env": "node scripts/initialize-env.mjs",
    "preaccount:create": "node scripts/ensure-prisma.mjs",
    "account:create": "tsx scripts/create-account.ts",
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "prisma generate && next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "predb:seed": "node scripts/ensure-prisma.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker.ts",
    "contacts:list": "tsx scripts/list-contact-requests.ts",
    "readiness": "tsx scripts/check-readiness.ts",
    "smtp:verify": "tsx scripts/verify-smtp.ts",
    "backup:rehearse": "node scripts/rehearse-backup.mjs",
    "format": "prettier --write src tests scripts prisma/seed.ts *.ts *.mjs *.json *.md"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.12.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer-modern": "npm:nodemailer@^10.4.0",
    "papaparse": "^5.5.3",
    "pg-boss": "^12.0.0",
    "pino": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    },
    "deepmerge-ts": "^8.0.0",
    "minimatch": "^11.0.5"
  },
  "type": "module",
  "license": "MIT"
}
